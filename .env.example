# Copy to `.env` and fill in. Bun loads `.env` automatically; the Worker reads
# these with effect/Config at deploy time, where Alchemy binds them onto the
# Worker and resolves them from the binding at runtime.

# The Cloudflare zone (domain) that hosts the Email Routing rules. Email
# Routing must be enabled for this zone on the account.
MAIL_ZONE=example.com

# How inbound mail is matched on the zone:
#   catch-all -> every message on the zone (the zone's catch-all rule)
#   literal   -> only the addresses listed in MAIL_INBOUND
MAIL_MATCH_MODE=catch-all

# Comma-separated inbound recipients to match when MAIL_MATCH_MODE=literal.
MAIL_INBOUND=inbox@example.com

# Comma-separated destinations every matched message is forwarded to.
# Each address MUST be a verified destination on the Cloudflare account
# (Cloudflare emails a confirmation link the first time one is used).
MAIL_FORWARD_TO=you@gmail.com,you@outlook.com
